<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      We inherit from spring-boot-starter-parent purely to reuse its curated dependency
      management (spring-web, reactor, jackson, junit, assertj, spring-test, ...). The
      published artifacts are plain libraries; no published module declares the
      spring-boot-maven-plugin, so nothing released is ever repackaged into a fat jar.
      (The demo module declares it to be runnable, but is never deployed.)
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>uz.uzinfoweb</groupId>
    <artifactId>ui-message-stream-parent</artifactId>
    <version>0.4.1</version>
    <packaging>pom</packaging>

    <name>UI Message Stream :: Parent</name>
    <description>
        App-agnostic Java implementation of the AI SDK v6 "UI Message Stream" wire protocol.
        Not affiliated with Vercel; implements the open protocol described at
        https://ai-sdk.dev/docs/ai-sdk-ui/stream-protocol
    </description>

    <!--
      OSS / Maven Central metadata. The repository, organization and developer values below are
      placeholders tied to the uz.uzinfoweb namespace — confirm them before the manual release.
      Central requires <url>, <licenses>, <scm> and <developers> to be present and the namespace
      (uz.uzinfoweb, verified via DNS TXT on uzinfoweb.uz) to be owned; fall back to io.github.<user>
      if the domain cannot be verified.
    -->
    <url>https://github.com/uzinfowebuz/ui-message-stream</url>

    <organization>
        <name>Uzinfoweb</name>
        <url>https://uzinfoweb.uz</url>
    </organization>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>uzinfoweb</id>
            <name>Uzinfoweb</name>
            <url>https://uzinfoweb.uz</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/uzinfowebuz/ui-message-stream.git</connection>
        <developerConnection>scm:git:git@github.com:uzinfowebuz/ui-message-stream.git</developerConnection>
        <url>https://github.com/uzinfowebuz/ui-message-stream</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>ui-message-stream-core</module>
        <module>ui-message-stream-spring</module>
        <module>ui-message-stream-spring-boot-starter</module>
        <module>ui-message-stream-demo</module>
    </modules>

    <properties>
        <!-- Toolchain supports 25 (matches the quizify backend). -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Confirmed against quizify-backend/pom.xml (Spring AI 2.0.0). -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>uz.uzinfoweb</groupId>
                <artifactId>ui-message-stream-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>uz.uzinfoweb</groupId>
                <artifactId>ui-message-stream-spring</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9.16,4.0.0)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Manual Maven Central release:  mvn -Prelease deploy
          Prerequisites:
            * a GPG key on the release machine (maven-gpg-plugin signs every artifact),
            * a ~/.m2/settings.xml <server> with id "central" holding a Sonatype Central token,
            * the uz.uzinfoweb namespace verified in the Central Portal.
          Source + javadoc jars are attached (Central requires both). Source and javadoc plugin
          versions come from spring-boot-starter-parent; GPG is pinned explicitly below.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
